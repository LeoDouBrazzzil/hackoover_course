    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.90.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "lucide-react": "^0.554.0",
    "node": "^25.2.0",
    "qs": "^6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.2",
    "redux": "^5.0.1",
    "styled-components": "^6.1.19",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
